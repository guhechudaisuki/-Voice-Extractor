# Keep source directories; other root directories contain local data.
/*/
!/.github/
!/extractor/
!/launcher/
!/scripts/
!/vendor/
!/model/
!/models/

# Local tests, evaluation scripts, and development notes
/tests/
/evaluation/
/docs/
/[计]划方案/
/[我]心危素材/
/output/
/cache/
/temp/
/logs/
/training/
/scripts/check_global_workbench.py
/scripts/check_peripheral_*.py
/scripts/check_peripheral_*.cjs
*.md
!/README.md
!**/LICENSE.md
!**/LICENSE.MD
/*.json
/*.ps1
/.*
!/.gitignore
!/.gitattributes
!/.github/

# Python environments and caches
__pycache__/
*.py[cod]
*.pyd
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/

# Build output and local configuration
build/
dist/
bin/
obj/
*.exe
*.dll
*.spec
!VoiceExtractor.spec
*.log
*.tmp
*.bak
*.previous
*.rebond
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
.idea/
.vscode/
*.user
*.suo

# Input media and generated archives
*.wav
*.mp3
*.flac
*.m4a
*.aac
*.ogg
*.mp4
*.mkv
*.avi
*.zip
*.7z
*.tar
*.gz

# Downloaded weights and model caches
*.pth
*.pt
*.ckpt
*.bin
*.onnx
*.safetensors
*.npz
hf_cache/
modelscope_cache/
/models/*
!/models/anime_t3/
/models/anime_t3/*
!models/anime_t3/classifier_v2.pt
!/models/wavlm-base-plus-sv/
/models/wavlm-base-plus-sv/*
!models/wavlm-base-plus-sv/auto_negatives.npz
/model/*
!/model/speaker/
/model/speaker/*
!/model/speaker/wavlm-base-plus-sv/
/model/speaker/wavlm-base-plus-sv/*
